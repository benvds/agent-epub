{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent EPUB book request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "inputs"],
  "properties": {
    "schema_version": {"const": 1},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "author": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "cover": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "alt": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "inputs": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1},
          "format": {"enum": ["text", "markdown"]},
          "name": {"type": "string", "minLength": 1}
        },
        "oneOf": [
          {"required": ["path"], "not": {"anyOf": [{"required": ["content"]}, {"required": ["name"]}]}},
          {"required": ["content", "format"], "not": {"required": ["path"]}}
        ]
      }
    }
  }
}
